      "icon": "https://cdn.agentclientprotocol.com/registry/v1/latest/auggie.svg",
      "distribution": {
        "npx": {
          "package": "@augmentcode/auggie@0.36.0",
          "args": [
            "--acp"
          ],
          "env": {
            "AUGMENT_DISABLE_AUTO_UPDATE": "1"
          }
        }
      }
    },
