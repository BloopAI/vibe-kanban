# Optional overrides for scripts/release-local.sh. Copy to .env.release
# (gitignored). Each value is taken from the environment first, then
# .env.release, then .env.

# Required (usually already in .env).
VK_SHARED_API_BASE=https://api.vibekanban.com
VITE_PUBLIC_REACT_VIRTUOSO_LICENSE_KEY=

# Optional. The relay is sunset; without it relay features report unavailable.
VK_SHARED_RELAY_API_BASE=

# There are no analytics settings: release builds always clear POSTHOG_* and
# SENTRY_* and fail if a key ends up in the output anyway.
